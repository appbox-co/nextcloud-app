 # Waits until nginx and php-fpm answer index.php. Redirects are not followed:
 # an installed Nextcloud redirects to https://<host>/login, which curl cannot
 # verify inside the container. A fresh install waits for 200 or a redirect
-# (the first request installs Nextcloud from autoconfig.php); an existing
-# installation may also answer 401, 403 or 503 (maintenance mode, or an
-# upgrade pending). The 31.0.4-2 loop (grep for '200' in the headers) only
-# returned because the HSTS max-age value contains "200", and could wait
-# forever on a 503.
+# (the first request installs Nextcloud from autoconfig.php). For an existing
+# installation any answer from PHP will do, including 500 (an installation
+# whose code is several major versions ahead of its database) and 503
+# (maintenance mode or an upgrade pending); only no answer, 502 and 504 mean
+# nginx or php-fpm is not ready yet. 31.0.4-3 accepted only 200, redirects,
+# 401, 403 and 503, so such installations waited here forever.
 wait_for_web() {
     local code
     while :; do
         code=$(curl -s -o /dev/null -w '%{http_code}' http://"$HOSTNAME":80/index.php)
         case "$1:$code" in
-            fresh:200|fresh:30[1237]|existing:200|existing:30[123478]|existing:401|existing:403|existing:503) return 0 ;;
+            fresh:200|fresh:30[1237]) return 0 ;;
+            existing:000|existing:502|existing:504) ;;
+            existing:[1-5][0-9][0-9]) return 0 ;;
         esac
         printf '.'
         sleep 1
     done
 }
 
+# Gives everything under /storage mode 0770 and owner appbox:appbox, as the
+# two per-file find passes before it did, but changes only entries that are
+# not already like that, and runs chmod and chown on batches of entries
+# ({} +) instead of starting one process per file, which kept large
+# installations offline for hours on every update. Symbolic links are passed
+# to chmod and chown as before (both follow them). The -path patterns are left
+# unquoted on purpose: the shell expands them the same way as in the earlier
+# passes, so the same entries are matched. It still runs before nginx starts,
+# so Nextcloud never serves files whose owner or mode are wrong.
+fix_storage_permissions() {
+    local start modes owners
+    start=$(date +%s)
+    modes=$(find /storage -not \( -path */apps/* -prune \) -not \( -path */apps/ -prune \) ! -perm 0770 -print -exec chmod 0770 {} + | wc -l)
+    owners=$(find /storage -not \( -path */apps/* -prune \) -not \( -path */apps/ -prune \) \( -type l -o ! -user appbox -o ! -group appbox \) -print -exec chown appbox:appbox {} + | wc -l)
+    echo "appbox-installer: storage permissions: chmod 0770 on $modes entries, chown appbox:appbox on $owners entries, in $(( $(date +%s) - start ))s"
+}
